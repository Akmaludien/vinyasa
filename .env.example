# Vinyasa — Nexora integration (server-side only)
# The token below is read by server routes only and is never sent to the client.

# Base URL of the running Nexora instance (http://localhost:3000 in dev,
# a secure, network-reachable https endpoint in production).
# Accepts either NEXORA_BASE_URL or NEXORA_API_URL.
NEXORA_BASE_URL=http://localhost:3000

# Shared secret that must match NEXORA_INTEGRATION_TOKEN on the Nexora side.
NEXORA_INTEGRATION_TOKEN=

# Read/write timeout for Nexora requests in milliseconds (default 15000).
NEXORA_TIMEOUT_MS=15000

# Caller credential for Vinyasa's own /api/nexora/* proxy routes. Required:
# while unset, every proxy call is denied (503). The operator enters this value
# in the Nexora panel; it is sent as the `x-vinyasa-proxy-key` header, held in
# component state only, and never persisted to localStorage.
# Use a long random value; never reuse NEXORA_INTEGRATION_TOKEN here.
VINYASA_PROXY_KEY=
